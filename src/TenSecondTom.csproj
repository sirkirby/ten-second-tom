<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>ten-second-tom-secrets</UserSecretsId>
    
    <!-- Trimming configuration for self-contained publishing -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- Enable JSON serialization reflection for Anthropic SDK compatibility -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Suppress specific trimming warnings -->
    <NoWarn>$(NoWarn);IL2026;IL2067;IL2070;IL2075;IL2077;IL3050</NoWarn>
    <!-- Suppress code analysis warnings for reusable shared components -->
    <NoWarn>$(NoWarn);CA1515;CA1716</NoWarn>
    <!-- Suppress obsolete warnings for backward compatibility deprecated items -->
    <!-- These are separate from ConfigurationSettings which has been completely removed -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <!-- Preserve assemblies that are loaded via reflection (e.g., Serilog sinks, MediatR handlers) -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Serilog.Sinks.Console" />
    <TrimmerRootAssembly Include="Serilog.Sinks.File" />
    <TrimmerRootAssembly Include="Serilog.Enrichers.Environment" />
    <TrimmerRootAssembly Include="Serilog.Settings.Configuration" />
    <TrimmerRootAssembly Include="Anthropic.SDK" />
    <TrimmerRootAssembly Include="MediatR" />
    <TrimmerRootAssembly Include="FluentValidation" />
    <TrimmerRootAssembly Include="TenSecondTom" />
    <!-- Microsoft AI Foundry Local SDK and dependencies (uses reflection for model loading) -->
    <TrimmerRootAssembly Include="Microsoft.AI.Foundry.Local" />
    <TrimmerRootAssembly Include="Betalgo.Ranul.OpenAI" />
    <!-- Whisper.NET for local speech-to-text (native interop) -->
    <TrimmerRootAssembly Include="Whisper.net" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include appsettings.json in single-file bundle and extract at runtime -->
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic.SDK" Version="5.5.3" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <PackageReference Include="Markdig" Version="0.42.0" />
    <PackageReference Include="MediatR" Version="13.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.9" />
    <PackageReference Include="Microsoft.AI.Foundry.Local" Version="0.8.2.1" />
  </ItemGroup>

  <!-- Whisper.NET: Platform-specific runtimes for optimized binary size -->
  <!-- Release builds use platform-specific runtimes; dev builds use AllRuntimes -->
  <ItemGroup>
    <!-- Core Whisper.NET library (required for all platforms) -->
    <PackageReference Include="Whisper.net" Version="1.9.0" />

    <!-- Development: AllRuntimes when no RuntimeIdentifier specified (dotnet build/run) -->
    <PackageReference Include="Whisper.net.AllRuntimes" Version="1.9.0"
                      Condition="'$(RuntimeIdentifier)' == ''" />

    <!-- Release: macOS CoreML for Apple Silicon hardware acceleration -->
    <PackageReference Include="Whisper.net.Runtime.CoreML" Version="1.9.0"
                      Condition="$(RuntimeIdentifier.StartsWith('osx-'))" />

    <!-- Release: Windows CUDA for NVIDIA GPU acceleration -->
    <PackageReference Include="Whisper.net.Runtime.Cuda" Version="1.9.0"
                      Condition="$(RuntimeIdentifier.StartsWith('win-'))" />

    <!-- Release: Linux CPU runtime with AVX2/FMA optimization -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0"
                      Condition="$(RuntimeIdentifier.StartsWith('linux-'))" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <Target Name="CopyExtensions" AfterTargets="Build;Publish" Condition="Exists('..\bin\TenSecondTom.Extensions.MacOS.app')">
    <ItemGroup>
      <ExtensionFiles Include="..\bin\TenSecondTom.Extensions.MacOS.app\**\*" />
    </ItemGroup>
    <!-- Copy to OutDir for Build -->
    <Copy SourceFiles="@(ExtensionFiles)" DestinationFolder="$(OutDir)\TenSecondTom.Extensions.MacOS.app\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' == ''" />
    <!-- Copy to PublishDir for Publish -->
    <Copy SourceFiles="@(ExtensionFiles)" DestinationFolder="$(PublishDir)\TenSecondTom.Extensions.MacOS.app\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>

  <ItemGroup>
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" />
    <PackageReference Include="OpenAI" Version="2.5.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.51.1" />
    <PackageReference Include="SSH.NET" Version="2025.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-rc.1.25451.107" />
    <PackageReference Include="System.IO.Abstractions" Version="21.1.7" />
    <PackageReference Include="Terminal.Gui" Version="1.*" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure/Prompts/Templates/**/*.md" />
  </ItemGroup>

</Project>
